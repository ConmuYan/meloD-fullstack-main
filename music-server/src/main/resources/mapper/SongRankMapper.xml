<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.yin.mapper.SongRankMapper">
  <resultMap id="BaseResultMap" type="com.example.yin.model.domain.SongRank">
    <result column="id" property="id" jdbcType="BIGINT" />
    <result column="songId" property="songId" jdbcType="BIGINT" />
    <result column="consumerId" property="consumerId" jdbcType="BIGINT" />
    <result column="score" property="score" jdbcType="INTEGER" />
    <result column="createTime" property="createTime" jdbcType="TIMESTAMP" />
    <result column="updateTime" property="updateTime" jdbcType="TIMESTAMP" />
  </resultMap>

  <select id="selectScoreSum" resultType="java.lang.Integer">
    SELECT COALESCE(sum(score), 0) as score from song_rank where song_id = #{0} ;
  </select>

  <select id="selectUserRank" resultType="java.lang.Integer" parameterType="com.example.yin.model.domain.SongRank">
    select score
    from song_rank
    where consumer_id = #{consumer_id, jdbcType=BIGINT} and song_id = #{song_id, jdbcType=BIGINT}
  </select>

</mapper>